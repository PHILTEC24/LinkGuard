# Django Core Configuration
DJANGO_SECRET_KEY=generate-a-strong-random-key-here-for-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL Database
POSTGRES_DB=linkguard
POSTGRES_USER=linkguard
POSTGRES_PASSWORD=linkguard_secret_pwd
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis & Celery
REDIS_URL=redis://redis:6379/0

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Scanner Engine Limits & Rate Limiting
THROTTLE_SCAN=60/hour
THROTTLE_SCAN_ANON=10/hour
THROTTLE_BATCH=5/hour
PROVIDER_TIMEOUT=6
ALLOW_DIRECT_PROBE=0
PROVIDERS_ENABLED=safe_browsing,virustotal,urlhaus,phishtank,dns_rdap

# Third-Party Threat Intelligence API Keys (Leave blank if inactive)
GOOGLE_SAFE_BROWSING_KEY=
VIRUSTOTAL_KEY=
URLHAUS_KEY=
PHISHTANK_KEY=

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api

